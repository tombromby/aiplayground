# S3 bucket containing Kiro usage reports
S3_BUCKET_NAME=ourkiro-pro-activity-us-east-1
# S3 path prefix (everything before the date portion)
S3_PREFIX=activity/AWSLogs/282248574218/KiroLogs/user_report/us-east-1
# AWS account ID (used in filename matching)
AWS_ACCOUNT_ID=9274642384218
# AWS region for the S3 client
AWS_REGION=us-east-1

# CUR 2.0 Data Export (Bedrock usage)
# S3 bucket for the Cost and Usage Report export
CUR_S3_BUCKET=cost-optimisation25
# S3 prefix up to (but not including) BILLING_PERIOD=
CUR_S3_PREFIX=2025/cost-optimsation2025/data
# Export name (used to find parquet files within the partition)
CUR_EXPORT_NAME=cost-optimsation2025
